# Optional environment overrides for howdy-attempt-watch.
# Install by copying to ~/.config/howdy-attempt-capture/capture.env.
#
# Where IR photos are stored (default: ~/Pictures/lock-attempts).
# HOWDY_ATTEMPT_PHOTO_DIR=/home/you/Pictures/lock-attempts
#
# Override the capture helper location (default: ~/.local/bin/howdy-attempt-capture).
# HOWDY_ATTEMPT_CAPTURE=/home/you/.local/bin/howdy-attempt-capture
