# Copy to ~/.config/howdy-attempt-capture/telegram.env and chmod 600.
# Or run: howdy-attempt-telegram-setup
#
# Get a token from @BotFather in Telegram (/newbot).
TELEGRAM_BOT_TOKEN=
# Numeric chat ID, or @channelusername. The setup script can detect it.
TELEGRAM_CHAT_ID=
# Optional: pin a working Telegram Bot API address when the IP returned by
# DNS is blackholed on your network. Leave empty to use normal DNS.
# TELEGRAM_API_IP=149.154.167.220
